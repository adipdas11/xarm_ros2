<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>disassembly_v3</name>
  <version>0.0.0</version>
  <description>Modular disassembly pipeline using vision, planning velocity control</description>
  <maintainer email="adipdas11@gmail.com">adip</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Dependencies for generating and using .srv/.action files -->
  <member_of_group>rosidl_interface_packages</member_of_group>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>action_msgs</build_depend>
  <build_depend>builtin_interfaces</build_depend>

  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Runtime dependencies for your Python nodes -->
  <build_depend>rclpy</build_depend>
  <exec_depend>rclpy</exec_depend>
  <build_depend>message_filters</build_depend>
  <exec_depend>message_filters</exec_depend>
  <build_depend>cv_bridge</build_depend>
  <exec_depend>cv_bridge</exec_depend>
  <build_depend>networkx</build_depend>
  <exec_depend>networkx</exec_depend>
  <build_depend>ultralytics</build_depend>
  <exec_depend>ultralytics</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>







