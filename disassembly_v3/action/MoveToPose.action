# MoveToPose.action
# Defines the MoveToPose action: servo the robot TCP to a goal PoseStamped using PID based Cartesian velocity control, with feedback and tolerance.
# Goal
geometry_msgs/PoseStamped target
float32 tolerance
float32 max_linear_speed
float32 max_angular_speed
---
# Result
bool success
string message
---
# Feedback
float32[3] linear_error
float32[3] angular_error
